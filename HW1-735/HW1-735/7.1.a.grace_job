#!/bin/bash
#SBATCH --export=NONE
#SBATCH --get-user-env

#SBATCH --job-name=pi_p1
#SBATCH --time=0:30:00
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --ntasks=1
#SBATCH --mem=8G
#SBATCH --output=n-tasks4-p-1.txt

module load intel

echo "p = 1"

echo "n = 10^2"
mpirun -np 1 ./compute_pi_mpi.exe 100

echo "n = 10^4"
mpirun -np 1 ./compute_pi_mpi.exe 10000

echo "n = 10^6"
mpirun -np 1 ./compute_pi_mpi.exe 1000000

echo "n = 10^8"
mpirun -np 1 ./compute_pi_mpi.exe 100000000
